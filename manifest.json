{
  "manifest_version": 3,
  "name": "Tab Tack",
  "version": "1.3.1",
  "description": "Click the toolbar button to save the current tab's title, URL, and your own annotation to a running markdown file.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-notes-md@haim.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Add tab to markdown notes",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
